<Window x:Class="SmartBilling.Desktop.Views.PrinterPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose label printer" Width="420" Height="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Select the printer for barcode labels. Labels will print to it without a dialog." />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" Width="80" Margin="0,0,8,0" Click="OnOkClicked" />
            <Button Content="Cancel" IsCancel="True" Width="80" />
        </StackPanel>
        <ListBox x:Name="PrinterList" MouseDoubleClick="OnOkClicked" />
    </DockPanel>
</Window>
