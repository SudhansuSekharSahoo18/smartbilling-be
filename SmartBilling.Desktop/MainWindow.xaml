<Window x:Class="SmartBilling.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Smart Billing" Icon="smartbilling_icon.ico"
        Height="768" Width="1280" MinHeight="700" MinWidth="1024"
        WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <!-- WebView2 is a native window that always draws over WPF content, so it is hidden while the overlay shows. -->
        <wv2:WebView2 x:Name="AppView">
            <wv2:WebView2.Style>
                <Style TargetType="wv2:WebView2">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverlayVisible}" Value="True">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </wv2:WebView2.Style>
        </wv2:WebView2>
        <Border Background="#F4F6F8"
                Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Width="480" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Smart Billing" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,20" />
                <TextBlock Text="Server URL" FontSize="12" Margin="0,0,0,4" />
                <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="6,4" />
                <TextBlock Text="Leave blank to use the built-in server on this PC. Enter an address only to use a shared server on the network."
                           TextWrapping="Wrap" FontSize="12" Foreground="#5F6B76" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Retry" Command="{Binding RetryCommand}" Padding="16,6" Margin="0,0,8,0" />
                    <Button Content="Save &amp; Retry" Command="{Binding SaveAndRetryCommand}" Padding="16,6" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
